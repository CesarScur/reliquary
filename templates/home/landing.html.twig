{% extends 'landing_base.html.twig' %}

{% block title %}{{ 'home.title'|trans({}, 'home') }} - {{ 'home.welcome'|trans({}, 'home') }}{% endblock %}

{% block body %}

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">{{ 'common.reliquary'|trans({}, 'common') }}</h1>
            <p class="hero-subtitle">{{ 'hero.subtitle'|trans({}, 'landing') }}</p>
            <p class="hero-description">
                {{ 'hero.description'|trans({}, 'landing') }}
            </p>
            <div class="cta-buttons">
                <a href="{{ path('app_relic_index') }}"
                   class="btn btn-primary">{{ 'hero.explore_collection'|trans({}, 'landing') }}</a>
                {% if app.user %}
                    <a href="{{ path('app_relic_new') }}"
                       class="btn btn-secondary">{{ 'hero.submit_relic'|trans({}, 'landing') }}</a>
                {% else %}
                    <a href="{{ path('app_register') }}"
                       class="btn btn-secondary">{{ 'hero.join_now'|trans({}, 'landing') }}</a>
                {% endif %}
            </div>
        </div>
        <div class="scroll-indicator"></div>
    </section>

    <!-- Statistics Section -->
    <section class="statistics-section">
        <div class="statistics-container">
            <div class="statistics-grid" data-controller="stats-counter">
                <div class="stat-card">
                    <div class="stat-icon-wrapper">
                        <i class="fas fa-cross"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value" data-stats-counter-target="value" data-value="{{ stats.total_relics }}">0</span>
                        <span class="stat-label">{{ 'stats.relics'|trans({}, 'landing') }}</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrapper">
                        <i class="fas fa-pray"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value" data-stats-counter-target="value" data-value="{{ stats.total_saints }}">0</span>
                        <span class="stat-label">{{ 'stats.saints'|trans({}, 'landing') }}</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon-wrapper">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="stat-content">
                        <span class="stat-value" data-stats-counter-target="value" data-value="{{ stats.total_locations }}">0</span>
                        <span class="stat-label">{{ 'stats.locations'|trans({}, 'landing') }}</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Relic Classes Section -->
    <section class="relic-classes">
        <h2 class="section-title">{{ 'classes.title'|trans({}, 'landing') }}</h2>
        <p class="section-subtitle">{{ 'classes.subtitle'|trans({}, 'landing') }}</p>

        <div class="classes-grid">
            <a href="{{ path('app_relic_index', {'filter': 'first-class'}) }}" class="relic-card">
                <span class="relic-icon">⊕</span>
                <h3 class="relic-title">{{ 'classes.first.title'|trans({}, 'landing') }}</h3>
                <p class="relic-description">
                    {{ 'classes.first.description'|trans({}, 'landing') }}
                </p>
            </a>
            <a href="{{ path('app_relic_index', {'filter': 'second-class'}) }}" class="relic-card">
                <span class="relic-icon">✠</span>
                <h3 class="relic-title">{{ 'classes.second.title'|trans({}, 'landing') }}</h3>
                <p class="relic-description">
                    {{ 'classes.second.description'|trans({}, 'landing') }}
                </p>
            </a>
            <a href="{{ path('app_relic_index', {'filter': 'third-class'}) }}" class="relic-card">
                <span class="relic-icon">✚</span>
                <h3 class="relic-title">{{ 'classes.third.title'|trans({}, 'landing') }}</h3>
                <p class="relic-description">
                    {{ 'classes.third.description'|trans({}, 'landing') }}
                </p>
            </a>
        </div>
    </section>

    <!-- Featured Saints Section -->
    <section class="featured-saints">
        <h2 class="section-title">{{ 'saints.title'|trans({}, 'landing') }}</h2>
        <p class="section-subtitle">{{ 'saints.subtitle'|trans({}, 'landing') }}</p>
        {% block saints_content %}
            <div class="saints-carousel" data-controller="carousel">
                {# Prepend Saint of the Day as a special card inside the carousel #}
                {% if saintOfDay %}
                <div class="saint-card saint-of-day" style="cursor: pointer;" data-controller="link" data-link-url-value="{{ path('app_saint_show', {'id': saintOfDay.id}) }}" data-action="click->link#click">
                        <div class="saint-image">
                            <div class="sod-label"><i class="fas fa-star me-1"></i> {{ 'home.saint_of_day'|trans({}, 'home')|default('Saint of the Day') }}</div>
                            {% if saintOfDay.images is defined and saintOfDay.images|length > 0 %}
                                <img src="{{ image_url(saintOfDay.images.first.thumbnailFilename ?? saintOfDay.images.first.filename) }}" alt="{{ saintOfDay.name }}" />
                            {% endif %}
                        </div>
                        <div class="saint-info">
                            <h3 class="saint-name">{{ saintOfDay|format_saint_name }}</h3>
                            {% if saintOfDay.feastDate %}
                                <p class="saint-dates">{{ saintOfDay.feastDate|format_date('medium', pattern=('common.date_formats.feast_date'|trans({}, 'common'))) }}</p>
                            {% endif %}
                            {% if saintOfDay.saintPhrase %}
                                <p class="saint-bio">{{ saintOfDay.getTranslatedPhrase(app.request.locale) }}</p>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {# Render the rest of featured saints; avoid duplicating the SoD if present in the list #}
                {% for saint in featuredSaints %}
                    {% if not (saintOfDay and saint.id == saintOfDay.id) %}
                        <div class="saint-card" style="cursor: pointer;" data-controller="link" data-link-url-value="{{ path('app_saint_show', {'id': saint.id}) }}" data-action="click->link#click">
                        <div class="saint-image">
                            {% if saint.images.first %}
                                <img src="{{ image_url(saint.images.first.thumbnailFilename ?? saint.images.first.filename) }}" alt="{{ saint.name }}" />
                            {% endif %}
                        </div>
                        <div class="saint-info">
                            <h3 class="saint-name">{{ saint|format_saint_name }}</h3>
                            {% if saint.feastDate %}
                                <p class="saint-dates">{{ saint.feastDate|format_date('medium', pattern=('common.date_formats.feast_date'|trans({}, 'common'))) }}</p>
                            {% endif %}
                            <p class="saint-bio">
                                {{ saint.getTranslatedPhrase(app.request.locale) }}
                            </p>
                        </div>
                    </div>
                    {% endif %}
                {% else %}
                    {# Fallback example card if there are no featured saints at all #}
                    <div class="saint-card">
                        <div class="saint-image"></div>
                        <div class="saint-info">
                            <h3 class="saint-name">{{ 'saints.francis.name'|trans({}, 'landing') }}</h3>
                            <p class="saint-dates">{{ 'saints.francis.dates'|trans({}, 'landing') }}</p>
                            <p class="saint-bio">
                                {{ 'saints.francis.bio'|trans({}, 'landing') }}
                            </p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endblock %}
    </section>
{% endblock %}

